API=https://models.sjtu.edu.cn/api/v1
API_SECRET=your-api-key
API_MODEL=deepseek-reasoner

# Optional RAG retrieval/index settings. RAG LLM calls reuse API/API_SECRET/API_MODEL above.
# RAG_CHROMA_DB_PATH=datasets/ChromaDB_data_populate/DataBase/data
# RAG_DATA_ROOT=datasets
# RAG_TOP_K=5
# RAG_COLLECTION_KEYWORDS=gossipcop,fever,claim
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_FALLBACK_MAJORITY_VOTE=false
# RAG_CHROMA_HF_REPO_ID=MingchenDai/NIS4307-ChromaDB_data_populate
# RAG_CHROMA_HF_REPO_TYPE=dataset
# RAG_CHROMA_HF_REVISION=main
# RAG_CHROMA_HF_ARCHIVE=ChromaDB_data_populate.zip

# Optional Hugging Face / Chroma behavior for RAG retrieval and index building.
# HF_ENDPOINT=https://hf-mirror.com
# RAG_HF_HUB_OFFLINE=true
# RAG_TRANSFORMERS_OFFLINE=true
