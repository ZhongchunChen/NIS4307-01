API=https://models.sjtu.edu.cn/api/v1
API_SECRET=your-api-key
API_MODEL=deepseek-reasoner

# Optional RAG overrides. Leave unset to reuse API/API_SECRET/API_MODEL above.
# RAG_OPENAI_API_BASE=https://models.sjtu.edu.cn/api/v1
