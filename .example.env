# RAG_LLM_TEMPERATURE=0.2
# RAG_LLM_MAX_TOKENS=512
# RAG_LLM_TIMEOUT=60
# RAG_FALLBACK_MAJORITY_VOTE=false

# Optional Hugging Face / Chroma behavior for RAG retrieval and index building.
